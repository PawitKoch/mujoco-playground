<!-- A free-floating "T-handle" (three different principal inertias) spinning
     almost exactly about its INTERMEDIATE axis: the Dzhanibekov effect. The
     spin is unstable, so the handle keeps flipping over. That makes
     it a sharp test of how accurately an integrator tracks free-joint
     orientation. -->
<mujoco model="tumbling_t_handle">
  <option gravity="0 0 0" integrator="RK4" timestep="0.01"/>
  <visual><global offwidth="1280" offheight="960"/></visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".25 .3 .4" rgb2=".02 .02 .05" width="32" height="512"/>
  </asset>
  <worldbody>
    <light pos="0 -1 2" dir="0 .5 -1"/>
    <body name="handle" pos="0 0 1">
      <freejoint/>
      <geom type="capsule" fromto="0 -.25 0 0 .25 0" size=".03" rgba=".85 .3 .2 1" mass="1"/>
      <geom type="capsule" fromto="0 0 0 .3 0 0" size=".03" rgba=".2 .5 .9 1" mass=".6"/>
    </body>
    <camera name="cam" pos=".9 -.9 1.4" mode="targetbody" target="handle"/>
  </worldbody>
</mujoco>
