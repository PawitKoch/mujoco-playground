<!-- A chaotic double pendulum. Energy computation is switched on so the
     Studio panel can show potential + kinetic energy as it sloshes around. -->
<mujoco model="double_pendulum">
  <option timestep="0.002" integrator="RK4">
    <flag energy="enable"/>
  </option>
  <statistic center="0 0 1" extent="1.5"/>
  <visual>
    <headlight active="auto"/>
    <rgba haze=".2 .25 .3 1"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .4 .55" rgb2=".05 .05 .1" width="32" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".15 .2 .25" rgb2=".2 .25 .3" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="4 4" texuniform="true" reflectance=".1"/>
  </asset>
  <worldbody>
    <light pos="0 -1 3" dir="0 .3 -1"/>
    <geom type="plane" size="0 0 .05" material="grid"/>
    <geom type="cylinder" fromto="0 -.05 1.6 0 .05 1.6" size=".03" rgba=".4 .4 .45 1"/>
    <body name="upper" pos="0 0 1.6">
      <joint name="shoulder" type="hinge" axis="0 1 0" damping="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 -.5" size=".03" rgba=".85 .4 .2 1" mass="1"/>
      <body name="lower" pos="0 0 -.5">
        <joint name="elbow" type="hinge" axis="0 1 0" damping="0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -.5" size=".03" rgba=".2 .6 .9 1" mass="1"/>
        <site name="tip" pos="0 0 -.5" size=".04" rgba="1 1 .3 1"/>
      </body>
    </body>
  </worldbody>
  <keyframe>
    <key name="chaos" qpos="2.2 -0.6"/>
  </keyframe>
</mujoco>
